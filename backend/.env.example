# Server
PORT=3000

# Pepper for Argon2id (keep this secret, never commit the real value!)
PEPPER=change_this_to_a_long_random_secret_string

# JWT - Ed25519 keys (generate these - see README)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Google OAuth 2.0 (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Session secret
SESSION_SECRET=change_this_to_another_long_random_string
